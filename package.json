{
  "name": "ai-taskboard",
  "version": "0.1.3-alpha",
  "private": true,
  "description": "An agent-native Kanban task board for software projects.",
  "desktopName": "ai-taskboard-desktop.desktop",
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "taskboard": "node src/cli/main.ts",
    "test": "node --test \"tests/**/*.test.ts\"",
    "check": "tsc --noEmit",
    "start": "electron .",
    "build:cli": "node scripts/build-cli.mjs",
    "package": "npm run build:cli && node scripts/package.mjs",
    "check:docs": "node scripts/check-docs.mjs"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "postject": "1.0.0-alpha.6",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.2",
    "fflate": "0.8.3",
    "markdown-it": "15.0.3",
    "prismjs": "1.30.0",
    "semver": "7.8.6"
  },
  "main": "src/desktop/main.ts",
  "license": "PolyForm-Noncommercial-1.0.0"
}
