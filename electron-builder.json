{
  "appId": "org.aitaskboard.desktop",
  "productName": "AI Taskboard",
  "directories": {
    "output": "release"
  },
  "files": [
    "src/**/*"
  ],
  "extraResources": [
    { "from": "THIRD_PARTY_NOTICES.md", "to": "THIRD_PARTY_NOTICES.md" },
    {
      "from": "dist/cli",
      "to": "bin",
      "filter": [
        "ai-taskboard",
        "ai-taskboard.exe",
        "LICENSE",
        "NOTICE",
        "README.md",
        "THIRD-PARTY-NOTICES.txt"
      ]
    },
    {
      "from": ".",
      "to": "licenses",
      "filter": [
        "LICENSE",
        "NOTICE",
        "README.md"
      ]
    }
  ],
  "win": {
    "target": [
      "nsis"
    ]
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowElevation": false,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "include": "build/installer.nsh",
    "allowToChangeInstallationDirectory": true
  },
  "mac": {
    "target": [
      "pkg"
    ],
    "extendInfo": {
      "NSMicrophoneUsageDescription": "AI Taskboard uses the microphone when you dictate a message to the project manager."
    },
    "category": "public.app-category.developer-tools"
  },
  "pkg": {
    "installLocation": "/Applications"
  },
  "linux": {
    "target": [
      "deb",
      "rpm"
    ],
    "category": "Development",
    "executableName": "ai-taskboard-desktop",
    "syncDesktopName": true
  },
  "deb": {
    "fpm": ["--depends", "libgbm1", "--depends", "libasound2t64 | libasound2"]
  },
  "rpm": {
    "fpm": ["--depends", "mesa-libgbm", "--depends", "alsa-lib"]
  },
  "artifactName": "ai-taskboard-${version}-${os}-${arch}.${ext}"
}
